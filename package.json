{
  "name": "web-resume-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Resume analysis web app: PDF and DOCX upload, a deterministic rules engine, job description matching and a REST API with OpenAPI. Next.js, strict TypeScript, Drizzle and PostgreSQL.",
  "author": "Folder IT (https://folderit.net)",
  "homepage": "https://github.com/FolderITDev/web-resume-analyzer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FolderITDev/web-resume-analyzer.git"
  },
  "bugs": {
    "url": "https://github.com/FolderITDev/web-resume-analyzer/issues"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "next build",
    "start": "next start --port 3010",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db-migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/db-seed.ts",
    "fixtures": "tsx scripts/generate-fixtures.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "motion": "^14.0.0",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "docx": "^9.8.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
