# PostgreSQL started by `docker compose up -d`
DATABASE_URL=postgres://resume:resume@localhost:5441/resume_analyzer

# Public origin used for canonical URLs, the sitemap and JSON-LD.
# The app itself is served under /apps/resume-analyzer (see src/config/site.ts).
SITE_ORIGIN=http://localhost:3010

# Base URL of the analysis engine that processes uploaded resumes (job API under /v1).
ANALYSIS_ENGINE_URL=
# Bearer token for the analysis engine, if it requires one.
ANALYSIS_ENGINE_API_KEY=
